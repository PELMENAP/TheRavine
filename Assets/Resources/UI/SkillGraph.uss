.skill-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    background-color: var(--ravine-surface-panel);
    color: var(--ravine-ink-primary);
    font-size: 14px;
}

.skill-panel__header {
    flex-direction: row;
    align-items: center;
    padding: 8px 16px;
    background-color: var(--ravine-surface-elevated);
    border-bottom-width: 1px;
    border-bottom-color: var(--ravine-border-subtle);
}

.skill-panel__title {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-right: 24px;
}

.skill-panel__budget {
    flex-grow: 1;
    color: var(--ravine-ink-secondary);
}

.skill-panel__body {
    flex-grow: 1;
    flex-direction: row;
}

.skill-card {
    width: 280px;
    padding: 12px;
    background-color: var(--ravine-surface-elevated);
    border-left-width: 1px;
    border-left-color: var(--ravine-border-subtle);
}

.skill-card__title {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.skill-card__body {
    white-space: normal;
    color: var(--ravine-ink-secondary);
}

.skill-confirm {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--ravine-bg-backdrop);
}

.skill-confirm__box {
    padding: 16px;
    background-color: var(--ravine-surface-elevated);
    border-width: 1px;
    border-color: var(--ravine-border-frame);
    border-radius: 0;
    max-width: 360px;
}

.skill-confirm__row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

.skill-canvas {
    background-color: var(--ravine-surface-canvas);
    overflow: hidden;
}

.skill-node {
    border-radius: 23px;
    align-items: center;
    justify-content: center;
    background-color: var(--ravine-node-base);
}

.skill-node--open {
    background-color: var(--ravine-node-open);
}

.skill-node--available {
    background-color: var(--ravine-node-available);
}

.skill-node--silhouette {
    opacity: 0.4;
}

.skill-node--island {
    opacity: 0.55;
    background-color: var(--ravine-node-island);
}

.skill-node--pruned {
    opacity: 0.65;
    background-color: var(--ravine-node-pruned);
}

.skill-node__level {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--ravine-ink-primary);
}

.skill-node__badge {
    position: absolute;
    font-size: 10px;
    color: var(--ravine-graph-badge-clique);
}

.skill-node__badge--clique {
    right: -2px;
    top: -4px;
}

.skill-node__badge--decay {
    left: -4px;
    bottom: -4px;
    color: var(--ravine-graph-badge-decay);
}

.skill-button {
    margin-left: 8px;
    padding: 4px 12px;
    color: var(--ravine-ink-primary);
    background-color: var(--ravine-surface-elevated);
    border-width: 1px;
    border-color: var(--ravine-border-frame);
    border-radius: 0;
}

.skill-button:hover {
    background-color: var(--ravine-surface-hover);
    border-color: var(--ravine-reticle-bracket);
}

.skill-node__name {
    position: absolute;
    font-size: 11px;
    color: var(--ravine-ink-secondary);
    -unity-text-align: upper-center;
    white-space: normal;
}

.skill-stats {
    position: absolute;
    left: 16px;
    bottom: 16px;
    padding: 8px 12px;
    background-color: var(--ravine-surface-panel);
    border-radius: 0;
    border-width: 1px;
    border-color: var(--ravine-border-subtle);
    color: var(--ravine-ink-secondary);
    font-size: 12px;
}

.skill-menu {
    width: 300px;
    padding: 12px;
    background-color: var(--ravine-surface-elevated);
    border-radius: 0;
    border-width: 1px;
    border-color: var(--ravine-border-frame);
}

.skill-menu__title {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.skill-menu__info {
    white-space: normal;
    color: var(--ravine-ink-secondary);
    margin-bottom: 8px;
}

.skill-menu__option {
    margin-left: 0;
    margin-top: 4px;
}

.skill-menu__note {
    white-space: normal;
    color: var(--ravine-signal-refusal);
    font-size: 12px;
    margin-top: 8px;
}

.skill-button:disabled {
    opacity: 0.45;
}
